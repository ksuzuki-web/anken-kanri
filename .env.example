# ===== 案件管理アプリ（必須） =====
VITE_SUPABASE_URL=ここにSupabaseプロジェクトのURLを貼る
VITE_SUPABASE_ANON_KEY=ここにSupabaseのanon public keyを貼る

# ===== Chatworkアシスタント（assistant/README.md 参照） =====
# 必須: Chatworkの右上プロフィール →「サービス連携」→「APIトークン」で発行
CHATWORK_API_TOKEN=

# 任意: AI要約・ナレッジ学習・Q&Aを使う場合（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=

# 任意: 朝ブリーフの投稿先ルームID（未設定なら自分のマイチャットに投稿）
# ルームIDはChatworkでそのルームを開いたときのURL末尾の数字（#!rid の後ろ）
CHATWORK_BRIEF_ROOM_ID=

# 任意: 使用するAIモデルを変えたい場合のみ
# ASSISTANT_MODEL=claude-sonnet-5
# ASSISTANT_LIGHT_MODEL=claude-haiku-4-5-20251001
